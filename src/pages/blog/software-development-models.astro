---
import HomeLayout from '@/layouts/HomeLayout.astro';
import HomeConnector from '@/components/HomeConnector.astro';
import BlogAuthor from '@/components/blog/BlogAuthor.astro';
import BlogShare from '@/components/blog/BlogShare.astro';
import { ArrowUpRight, Clock3 } from '@lucide/astro';
import { Content as ArticleBody, getHeadings } from '@/content/software-development-models-article.md';
import '@/styles/blog.css';

const article = {
  category: 'Product Engineering',
  date: 'AUG 26, 2026',
  dateTime: '2026-08-26',
  readTime: '12 min read',
  title: 'Top 5 essential software development models: from Waterfall to Agile',
  lead:
    'A practical guide to Waterfall, V-model, Iterative, Incremental, and Agile development models, with clear fit signals for choosing the right workflow.',
  href: '/blog/software-development-models/',
  image: '/images/blog/software-development-models-hero.webp'
};
const articleSrcset = '/images/blog/software-development-models-hero-768.webp 768w, /images/blog/software-development-models-hero-1200.webp 1200w, /images/blog/software-development-models-hero.webp 1672w';

const relatedArticle = {
  category: 'CMS & Engineering',
  date: 'AUG 23, 2026',
  dateTime: '2026-08-23',
  title: 'When should you choose Sanity CMS? A practical decision guide',
  lead:
    'Sanity can be an exceptional content foundation when structured content, editorial workflows, and multi-channel delivery matter.',
  href: '/blog/when-to-choose-sanity-cms/',
  image: '/images/blog/sanity-cms-structured-content-hero.webp',
  srcset: '/images/blog/sanity-cms-structured-content-hero-768.webp 768w, /images/blog/sanity-cms-structured-content-hero-1200.webp 1200w, /images/blog/sanity-cms-structured-content-hero.webp 1672w'
};

const shareUrl = `https://synoit.com${article.href}`;
const tocHeadings = getHeadings().filter(
  (heading) => heading.depth === 2 && heading.slug !== 'table-of-contents'
);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: article.title,
      description: article.lead,
      image: `https://synoit.com${article.image}`,
      datePublished: article.dateTime,
      dateModified: article.dateTime,
      mainEntityOfPage: shareUrl,
      author: {
        '@type': 'Organization',
        name: 'SynoIT',
        url: 'https://synoit.com/'
      },
      publisher: {
        '@type': 'Organization',
        name: 'SynoIT',
        url: 'https://synoit.com/'
      }
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        ['What are the top software development models?', 'Five essential software development models are Waterfall, V-model, Iterative, Incremental, and Agile.'],
        ['Which development model is best for an MVP?', 'Agile, Incremental, or Iterative delivery usually fits MVP work because the team can release early, learn from users, and adjust scope.'],
        ['When should a team use Waterfall?', 'Waterfall is useful when requirements are stable, documentation matters, and stakeholders need formal sign-off before each phase.'],
        ['Is Agile always better than Waterfall?', 'No. Agile is better for changing requirements, while Waterfall can be better for predictable, approval-heavy projects.'],
        ['Can teams combine software development models?', 'Yes. Many teams blend models, such as using Agile delivery with V-model validation for regulated parts of a product.']
      ].map(([name, text]) => ({
        '@type': 'Question',
        name,
        acceptedAnswer: { '@type': 'Answer', text }
      }))
    }
  ]
};
---

<HomeLayout
  title="Top 5 Essential Software Development Models | SynoIT"
  description="Compare the top 5 essential software development models, from Waterfall and V-model to Iterative, Incremental, and Agile delivery."
  canonical={article.href}
  image={article.image}
  schema={schema}
  ogType="article"
  publishedTime={article.dateTime}
  modifiedTime={article.dateTime}
>
  <main id="main" class="blog-page blog-article-page">
    <article class="blog-article" aria-labelledby="article-title">
      <header class="blog-article-hero">
        <div class="blog-post-meta">
          <a href="/blog/#categories">{article.category}</a>
          <span aria-hidden="true">·</span>
          <time datetime={article.dateTime}>{article.date}</time>
          <span aria-hidden="true">·</span>
          <span class="blog-read-time"><Clock3 aria-hidden="true" /> {article.readTime}</span>
        </div>

        <h1 id="article-title">{article.title}</h1>
        <p class="blog-article-lead">{article.lead}</p>

        <img
          class="blog-article-hero__image"
          src={article.image}
          srcset={articleSrcset}
          sizes="(max-width: 767px) calc(100vw - 40px), 704px"
          width="1672"
          height="941"
          alt="Five abstract software development workflows connected by luminous threads on a dark engineering interface"
          fetchpriority="high"
        />

        <div class="blog-mobile-byline">
          <BlogAuthor showRole />
          <BlogShare title={article.title} url={shareUrl} />
        </div>
      </header>

      <div class="blog-article-layout">
        <div class="blog-prose">
          <ArticleBody />
        </div>

        <aside class="blog-article-sidebar" aria-label="Article information">
          <nav class="blog-toc" aria-label="Table of contents">
            <p>In this article</p>
            <ol>
              {tocHeadings.map((heading, index) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link
                    class:list={{ 'is-active': index === 0 }}
                    aria-current={index === 0 ? 'location' : undefined}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>

          <div class="blog-sidebar-author">
            <p>Author</p>
            <BlogAuthor showRole />
          </div>

          <BlogShare title={article.title} url={shareUrl} compact />
        </aside>
      </div>

      <footer class="blog-article-footer">
        <BlogAuthor showRole />
        <BlogShare title={article.title} url={shareUrl} compact />
      </footer>
    </article>

    <HomeConnector />

    <section class="blog-related" aria-labelledby="related-posts-title">
      <h2 id="related-posts-title">Related post</h2>
      <div class="blog-related-grid">
        <article class="blog-related-card">
          <a class="blog-related-card__image" href={relatedArticle.href} aria-label={`Read ${relatedArticle.title}`}>
            <img src={relatedArticle.image} srcset={relatedArticle.srcset} sizes="(max-width: 767px) calc(100vw - 84px), (max-width: 1023px) 294px, 321px" width="1672" height="941" alt="" loading="lazy" decoding="async" />
          </a>
          <div class="blog-post-meta">
            <a href="/blog/#categories">{relatedArticle.category}</a>
            <span aria-hidden="true">·</span>
            <time datetime={relatedArticle.dateTime}>{relatedArticle.date}</time>
          </div>
          <h3><a href={relatedArticle.href}>{relatedArticle.title}</a></h3>
          <p>{relatedArticle.lead}</p>
          <BlogAuthor compact />
        </article>
      </div>
    </section>

    <HomeConnector flip />

    <section class="blog-editorial-cta blog-editorial-cta--article" aria-labelledby="article-cta-title">
      <div class="blog-editorial-cta__image" aria-hidden="true">
        <img src={article.image} srcset={articleSrcset} sizes="(max-width: 899px) calc(100vw - 40px), 604px" width="1672" height="941" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="blog-editorial-cta__content">
        <p class="blog-eyebrow">PRODUCT DELIVERY WORKSHOP</p>
        <h2 id="article-cta-title">Choose the model your project can actually run.</h2>
        <p>
          SynoIT helps teams turn product uncertainty, delivery pressure, and engineering constraints into a practical development roadmap.
        </p>
        <a class="blog-primary-link" href="/contact/">
          Plan your delivery model <ArrowUpRight aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
      const sections = tocLinks
        .map((link) => document.getElementById(link.getAttribute('href')?.slice(1) || ''))
        .filter(Boolean);

      const activateToc = (id) => {
        tocLinks.forEach((link) => {
          const active = link.getAttribute('href') === `#${id}`;
          link.classList.toggle('is-active', active);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };

      let frame = 0;
      const trackSection = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(() => {
          frame = 0;
          const marker = window.scrollY + Math.min(190, window.innerHeight * 0.28);
          let current = sections[0];
          sections.forEach((section) => {
            if (section.offsetTop <= marker) current = section;
          });
          if (current) activateToc(current.id);
        });
      };

      window.addEventListener('scroll', trackSection, { passive: true });
      window.addEventListener('resize', trackSection, { passive: true });
      window.addEventListener('hashchange', () => {
        if (window.location.hash) activateToc(window.location.hash.slice(1));
      });
      trackSection();

      const articleAnchors = Array.from(
        document.querySelectorAll('.blog-toc a[href^="#"], .blog-prose #table-of-contents + ol a[href^="#"]')
      );

      const scrollToArticleSection = (target, immediate = false) => {
        const topOffset = window.innerWidth <= 767 ? 88 : 104;
        const targetTop = target.getBoundingClientRect().top + window.scrollY - topOffset;
        if (window.__lenis?.scrollTo) {
          window.__lenis.scrollTo(targetTop, {
            immediate,
            duration: immediate ? 0 : 0.85
          });
          return;
        }

        window.scrollTo({
          top: targetTop,
          behavior: immediate || window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
        });
      };

      articleAnchors.forEach((link) => {
        link.addEventListener('click', (event) => {
          const hash = link.getAttribute('href');
          const target = hash ? document.querySelector(hash) : null;
          if (!hash || !target) return;

          event.preventDefault();
          event.stopImmediatePropagation();
          if (window.location.hash !== hash) window.history.pushState(null, '', hash);
          activateToc(hash.slice(1));
          scrollToArticleSection(target);
        }, true);
      });

      window.addEventListener('load', () => {
        const target = window.location.hash ? document.querySelector(window.location.hash) : null;
        if (!target) return;
        window.setTimeout(() => scrollToArticleSection(target, true), 0);
      });

      document.querySelectorAll('[data-copy-share]').forEach((button) => {
        button.addEventListener('click', async () => {
          const url = button.getAttribute('data-share-url') || window.location.href;
          const status = button.closest('.blog-share')?.querySelector('[data-copy-status]');
          try {
            await navigator.clipboard.writeText(url);
            if (status) status.textContent = 'Link copied';
          } catch {
            const input = document.createElement('textarea');
            input.value = url;
            input.setAttribute('readonly', '');
            input.style.position = 'fixed';
            input.style.opacity = '0';
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            input.remove();
            if (status) status.textContent = 'Link copied';
          }
          window.setTimeout(() => {
            if (status) status.textContent = '';
          }, 2200);
        });
      });
    })();
  </script>
</HomeLayout>
