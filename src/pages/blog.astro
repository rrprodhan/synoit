---
import HomeLayout from '@/layouts/HomeLayout.astro';
import HomeConnector from '@/components/HomeConnector.astro';
import HeroNet from '@/components/HeroNet.astro';
import BlogAuthor from '@/components/blog/BlogAuthor.astro';
import { ArrowUpRight } from '@lucide/astro';
import '@/styles/blog.css';

const post = {
  category: 'Product Engineering',
  date: 'AUG 26, 2026',
  dateTime: '2026-08-26',
  title: 'Top 5 essential software development models: from Waterfall to Agile',
  excerpt:
    'Compare Waterfall, V-model, Iterative, Incremental, and Agile delivery models so your team can match process, risk, release pressure, and stakeholder feedback to the right workflow.',
  href: '/blog/software-development-models/',
  image: '/images/blog/software-development-models-hero.webp',
  alt: 'Five abstract software development workflows connected by luminous threads on a dark engineering interface'
};
const postSrcset = '/images/blog/software-development-models-hero-768.webp 768w, /images/blog/software-development-models-hero-1200.webp 1200w, /images/blog/software-development-models-hero.webp 1672w';

const morePosts = [
  {
    category: 'CMS & Engineering',
    date: 'AUG 23, 2026',
    dateTime: '2026-08-23',
    title: 'When should you choose Sanity CMS? A practical decision guide',
    excerpt:
      'Sanity can be an exceptional content foundation when structured content, editorial workflows, and multi-channel delivery matter.',
    href: '/blog/when-to-choose-sanity-cms/',
    image: '/images/blog/sanity-cms-structured-content-hero.webp',
    srcset: '/images/blog/sanity-cms-structured-content-hero-768.webp 768w, /images/blog/sanity-cms-structured-content-hero-1200.webp 1200w, /images/blog/sanity-cms-structured-content-hero.webp 1672w'
  }
];
---

<HomeLayout
  title="SynoIT Blog | Practical Product, CMS and Engineering Insights"
  description="Read practical SynoIT guidance on headless CMS architecture, product engineering, design systems, AI, SEO, and sustainable digital growth."
  canonical="/blog/"
  image={post.image}
>
  <main id="main" class="blog-page blog-index-page">
    <section class="hero blog-hero" id="hero">
      <div class="hero-content">
        <p class="section-kicker">SYNOIT INSIGHTS</p>
        <h1 class="hero-title"><span class="line" data-split>Practical product, CMS &amp;</span>{' '}<span class="line accent" data-split>engineering insights.</span></h1>
        <p class="hero-sub reveal-line"><span>Field notes from the SynoIT studio on content architecture, product engineering, design systems, AI, and the decisions that keep digital products growing.</span></p>
      </div>
      <HeroNet />
    </section>

    <HomeConnector />

    <section class="blog-index-shell" aria-labelledby="featured-post-title">
      <article class="blog-feature-card">
        <div class="blog-post-meta">
          <a href="#categories">{post.category}</a>
          <span aria-hidden="true">·</span>
          <time datetime={post.dateTime}>{post.date}</time>
        </div>

        <a class="blog-feature-title" href={post.href}>
          <h2 id="featured-post-title">{post.title}</h2>
        </a>

        <div class="blog-feature-author">
          <BlogAuthor compact />
        </div>

        <div class="blog-feature-summary">
          <p>{post.excerpt}</p>
          <a class="blog-read-more" href={post.href}>
            Read more <ArrowUpRight aria-hidden="true" />
          </a>
        </div>

        <a class="blog-feature-image" href={post.href} aria-label={`Read ${post.title}`}>
          <img
            src={post.image}
            srcset={postSrcset}
            sizes="(max-width: 767px) calc(100vw - 84px), 414px"
            width="1672"
            height="941"
            alt={post.alt}
            fetchpriority="high"
          />
        </a>
      </article>

      <nav id="categories" class="blog-categories" aria-label="Blog categories">
        <a class="is-active" href="/blog/" aria-current="page">All posts</a>
        <a href="#featured-post-title">Product Engineering</a>
        <a href="#more-insights">CMS &amp; Engineering</a>
        <a href="/blog/#featured-post-title">Product strategy</a>
      </nav>
    </section>

    <HomeConnector flip />

    <section id="more-insights" class="blog-related" aria-labelledby="more-insights-title">
      <h2 id="more-insights-title">More insights</h2>
      <div class="blog-related-grid">
        {morePosts.map((relatedPost) => (
          <article class="blog-related-card">
            <a class="blog-related-card__image" href={relatedPost.href} aria-label={`Read ${relatedPost.title}`}>
              <img src={relatedPost.image} srcset={relatedPost.srcset} sizes="(max-width: 767px) calc(100vw - 84px), (max-width: 1023px) 294px, 321px" width="1672" height="941" alt="" loading="lazy" decoding="async" />
            </a>
            <div class="blog-post-meta">
              <a href="/blog/#categories">{relatedPost.category}</a>
              <span aria-hidden="true">·</span>
              <time datetime={relatedPost.dateTime}>{relatedPost.date}</time>
            </div>
            <h3><a href={relatedPost.href}>{relatedPost.title}</a></h3>
            <p>{relatedPost.excerpt}</p>
            <BlogAuthor compact />
          </article>
        ))}
      </div>
    </section>

    <HomeConnector />

    <section class="blog-editorial-cta" aria-labelledby="blog-cta-title">
      <div class="blog-editorial-cta__image" aria-hidden="true">
        <img src={post.image} srcset={postSrcset} sizes="(max-width: 899px) calc(100vw - 40px), 604px" width="1672" height="941" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="blog-editorial-cta__content">
        <p class="blog-eyebrow">SYNOIT DELIVERY</p>
        <h2 id="blog-cta-title">Turn process choice into delivery momentum.</h2>
        <p>
          SynoIT helps teams choose practical delivery models around scope, risk, feedback loops, and the speed their product actually needs.
        </p>
        <a class="blog-primary-link" href="/contact/">
          Plan your delivery model <ArrowUpRight aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>
</HomeLayout>
