---
import HomeLayout from '@/layouts/HomeLayout.astro';
import BlogAuthor from '@/components/blog/BlogAuthor.astro';
import { ArrowUpRight } from '@lucide/astro';
import '@/styles/blog.css';

const post = {
  category: 'CMS & Engineering',
  date: 'AUG 23, 2026',
  title: 'When should you choose Sanity CMS? A practical decision guide',
  excerpt:
    'Sanity can be an exceptional content foundation when structured content, editorial workflows, and multi-channel delivery matter. This guide helps teams recognize the right fit, the trade-offs, and the architecture needed around it.',
  href: '/blog/when-to-choose-sanity-cms/',
  image: '/images/blog/sanity-cms-structured-content-hero.webp'
};
const postSrcset = '/images/blog/sanity-cms-structured-content-hero-768.webp 768w, /images/blog/sanity-cms-structured-content-hero-1200.webp 1200w, /images/blog/sanity-cms-structured-content-hero.webp 1672w';
---

<HomeLayout
  title="SynoIT Blog | Practical Product, CMS and Engineering Insights"
  description="Read practical SynoIT guidance on headless CMS architecture, product engineering, design systems, AI, SEO, and sustainable digital growth."
  canonical="/blog/"
  image={post.image}
  effects="shell"
>
  <main id="main" class="blog-page blog-index-page">
    <h1 class="blog-sr-only">SynoIT insights</h1>

    <section class="blog-index-shell" aria-labelledby="featured-post-title">
      <article class="blog-feature-card">
        <div class="blog-post-meta">
          <a href="#categories">{post.category}</a>
          <span aria-hidden="true">·</span>
          <time datetime="2026-08-23">{post.date}</time>
        </div>

        <a class="blog-feature-title" href={post.href}>
          <h2 id="featured-post-title">{post.title}</h2>
        </a>

        <div class="blog-feature-author">
          <BlogAuthor compact />
        </div>

        <div class="blog-feature-summary">
          <p>{post.excerpt}</p>
          <a class="blog-read-more" href={post.href}>
            Read more <ArrowUpRight aria-hidden="true" />
          </a>
        </div>

        <a class="blog-feature-image" href={post.href} aria-label={`Read ${post.title}`}>
          <img
            src={post.image}
            srcset={postSrcset}
            sizes="(max-width: 767px) calc(100vw - 40px), 448px"
            width="1672"
            height="941"
            alt="A structured content platform distributing modular content to websites, mobile applications, and commerce experiences"
            fetchpriority="high"
          />
        </a>
      </article>

      <nav id="categories" class="blog-categories" aria-label="Blog categories">
        <a class="is-active" href="/blog/" aria-current="page">All posts</a>
        <a href="#featured-post-title">CMS &amp; Engineering</a>
        <a href="/blog/#featured-post-title">Product strategy</a>
      </nav>
    </section>

    <section class="blog-editorial-cta" aria-labelledby="blog-cta-title">
      <div class="blog-editorial-cta__image" aria-hidden="true">
        <img src={post.image} srcset={postSrcset} sizes="(max-width: 767px) calc(100vw - 40px), 604px" width="1672" height="941" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="blog-editorial-cta__content">
        <p class="blog-eyebrow">SYNOIT EDITORIAL</p>
        <h2 id="blog-cta-title">Turn content complexity into a clear product advantage.</h2>
        <p>
          SynoIT helps teams choose, model, and implement content platforms around real business workflows—not feature checklists.
        </p>
        <a class="blog-primary-link" href="/contact/">
          Plan your CMS architecture <ArrowUpRight aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>
</HomeLayout>
