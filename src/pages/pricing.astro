---
import HomeLayout from '@/layouts/HomeLayout.astro';
import HomeConnector from '@/components/HomeConnector.astro';
import HeroNet from '@/components/HeroNet.astro';
import PricingCard from '@/components/PricingCard.astro';

const plans = [
  { name: 'Common', accent: 'common', price: '$0', cents: '', unit: '/consultation', description: 'For individuals and teams exploring the right SynoIT solution.', features: ['Discovery call', 'Service fit assessment', 'High-level roadmap', 'Timeline and budget range', 'AI opportunity review'] },
  { name: 'Rare', accent: 'rare', price: '$1.9k', cents: '+', unit: '/project', description: 'For focused websites, landing pages, audits, and brand refreshes.', features: ['Strategy and scope sprint', 'Responsive UI design', 'SEO-ready build', 'Analytics setup', 'Launch support'] },
  { name: 'Epic', accent: 'epic', price: '$9.9k', cents: '+', unit: '/project', description: 'For product builds, SaaS MVPs, mobile apps, and integrations.', features: ['Product architecture', 'Custom web or app build', 'API and CRM integrations', 'QA and performance testing', 'Post-launch iteration'] },
  { name: 'Legendary', accent: 'legendary', price: '$39.9k', cents: '+', unit: '/engagement', description: 'For dedicated teams, AI systems, cloud platforms, and growth programs.', features: ['Dedicated delivery team', 'Cloud and DevOps systems', 'AI automation workflows', 'SEO and growth operations', 'Continuous optimization'] }
];

const projectTypes = [
  ['Website', 'Corporate, portfolio, or landing pages'],
  ['Web Application', 'SaaS, dashboards, or portals'],
  ['Mobile App', 'iOS, Android, or cross-platform'],
  ['E-Commerce', 'Online store with payments'],
  ['Branding & Design', 'Logo, identity, pitch decks'],
  ['Digital Marketing', 'SEO, social media, ads']
];

const features = ['Responsive Design', 'Content Management System', 'User Authentication', 'Payment Integration', 'Analytics Dashboard', 'API Integration', 'Live Chat / Chatbot', 'SEO Optimization', 'Multi-Language Support', 'Admin Panel'];
const complexity = [['Simple', '1-5 pages/screens, basic features'], ['Moderate', '6-15 pages/screens, custom features'], ['Complex', '15+ pages/screens, advanced integrations']];
const timelines = [['Urgent', 'ASAP within 2-4 weeks'], ['Standard', '1-2 months'], ['Flexible', '2-4 months, no rush']];
const process = [
  ['Type', 'Start with the product category so we can understand the delivery model, risk, and specialist mix.'],
  ['Features', 'Map the key functionality, integrations, content needs, analytics, AI, and operational workflows.'],
  ['Complexity', 'Estimate how much UX, architecture, QA, security, and coordination the project requires.'],
  ['Timeline', 'Balance launch urgency with quality, review cycles, and the team capacity needed to deliver well.']
];
---

<HomeLayout title="Pricing | SynoIT Project Estimator" description="Estimate SynoIT project timelines and engagement tiers for websites, apps, AI systems, SEO, branding, and dedicated teams." canonical="/pricing/">
  <main id="main" class="service-page">
    <section class="hero service-hero" id="hero">
      <div class="hero-content">
        <p class="section-kicker service-kicker">PRICING</p>
        <h1 class="hero-title"><span class="line" data-split>Transparent</span>{' '}<span class="line accent" data-split>pricing.</span></h1>
        <p class="hero-sub reveal-line"><span>Use these starting points to frame your project. For exact pricing, SynoIT prepares a detailed proposal after scope discovery.</span></p>
        <div class="hero-badges reveal-line"><span class="badges-wrap"><a href="mailto:support@synoit.com" class="store-btn"><span class="service-icon">↗</span><span><small>REQUEST ESTIMATE</small><b>Get a free quote</b></span></a><a href="/contact/" class="store-btn"><span class="service-icon">✦</span><span><small>DISCUSS SCOPE</small><b>Talk to SynoIT</b></span></a></span></div>
      </div>
      <HeroNet />
    </section>

    <HomeConnector />

    <section class="statement service-statement" id="statement">
      <div class="statement-pin" id="statementPin">
        <svg class="net statement-net" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none"><path class="spine" data-sdraw d="M50,0 V16" /><path data-sdraw d="M50,16 H84 Q90,16 90,22 V78 Q90,84 84,84 H16 Q10,84 10,78 V22 Q10,16 16,16 H50" /><path class="spine" data-sdraw d="M50,84 V100" /><path class="s-pulse" d="M50,16 H84 Q90,16 90,22 V78 Q90,84 84,84 H16 Q10,84 10,78 V22 Q10,16 16,16 H50" /><path class="s-pulse" d="M50,16 H84 Q90,16 90,22 V78 Q90,84 84,84 H16 Q10,84 10,78 V22 Q10,16 16,16 H50" /></svg>
        <p class="statement-text" id="statementText">Project type, features, complexity, and timeline determine the right team shape, delivery model, and final estimate.</p>
      </div>
    </section>

    <HomeConnector flip />

    <section class="pricing" id="pricing">
      <p class="section-kicker">ENGAGEMENT TIERS</p>
      <h2>Choose the delivery level<br />that fits your next move</h2>
      <div class="pricing-storm-grid">
        {plans.map((plan) => (
          <PricingCard
            name={plan.name}
            accent={plan.accent}
            price={plan.price}
            cents={plan.cents}
            suffix={plan.unit}
            description={plan.description}
            features={plan.features}
            ctaText="Request proposal"
          />
        ))}
      </div>
    </section>

    <HomeConnector />

    <section class="steps service-steps" id="steps">
      <div class="steps-pin" id="stepsPin">
        <div class="steps-head"><p class="section-kicker">PROJECT ESTIMATOR</p><h2>Answer four planning signals<br />before final pricing</h2></div>
        <div class="steps-body"><div class="steps-text"><div class="steps-rail"><div class="steps-rail-fill" id="stepsRailFill"></div><div class="steps-rail-dot" id="stepsRailDot"></div></div><div class="steps-counter"><span id="stepsCounterNum">01</span><span class="steps-counter-total"> / 04</span></div><div class="steps-dots" role="tablist" aria-label="Estimator steps">{process.map((_, index) => <button class:list={{ 'is-active': index === 0 }} aria-label={`Step ${index + 1}`} aria-selected={index === 0 ? 'true' : 'false'}>{String(index + 1).padStart(2, '0')}</button>)}</div>{process.map(([title, text], index) => <div class:list={['step-item', { 'is-active': index === 0 }]}><div class="step-num">{String(index + 1).padStart(2, '0')}</div><h3>{title}</h3><p>{text}</p><div class="step-line"><div class="step-line-fill"></div></div></div>)}</div><div class="steps-phone"><div class="phone-glow"></div><div class="phone-frame">{process.map(([title], index) => <div class:list={['step-video', { 'is-active': index === 0 }]}><strong>ESTIMATOR</strong><b>{title}</b><span></span><span></span><span></span></div>)}</div></div></div>
      </div>
    </section>

    <HomeConnector flip />

    <section class="features service-deliverables" id="features">
      <div class="edge-glow left"></div><div class="edge-glow right"></div>
      <h2 class="features-title">Scope inputs <span class="dim">from the v1 estimator</span></h2>
      <div class="service-grid">{projectTypes.map(([title, text], index) => <article class="f-card service-card"><span class="service-icon">{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
    </section>

    <HomeConnector />

    <section class="languages" aria-label="Common project features">
      <p class="section-kicker">COMMON FEATURES THAT AFFECT ESTIMATES</p>
      <div class="marquee"><div class="service-marquee-track">{features.map((feature) => <span class="lang-chip">{feature}</span>)}{features.map((feature) => <span class="lang-chip" aria-hidden="true">{feature}</span>)}</div></div>
    </section>

    <HomeConnector />

    <section class="signature service-outcomes" id="inside">
      <p class="section-kicker">COMPLEXITY AND TIMELINE</p>
      <h2 class="sig-title">Better estimates come from <span class="dim">clear constraints</span></h2>
      <div class="service-grid compact">{[...complexity, ...timelines].map(([title, text], index) => <article class="review-card"><span class="review-stars">{String(index + 1).padStart(2, '0')}</span><blockquote>{title}</blockquote><figcaption>{text}</figcaption></article>)}</div>
    </section>

    <HomeConnector />

    <section class="cta" id="cta">
      <h2 class="cta-title"><span class="line" data-split>Need exact pricing?</span>{' '}<span class="line accent" data-split>Send the scope and we’ll estimate it properly.</span></h2>
      <div class="hero-badges"><span class="badges-wrap"><a href="mailto:support@synoit.com" class="store-btn"><span class="service-icon">↗</span><span><small>REQUEST ESTIMATE</small><b>Get a free quote</b></span></a><a href="https://wa.me/6582034346" target="_blank" rel="noopener" class="store-btn"><span class="service-icon">✦</span><span><small>DISCUSS BUDGET</small><b>Chat with our team</b></span></a></span></div>
    </section>
  </main>
</HomeLayout>
