---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroNet from '@/components/HeroNet.astro';
import CTA from '@/components/CTA.astro';
import { getService, services } from '@/data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.shortTitle} by SynoIT`,
  description: service.description,
  provider: { '@type': 'Organization', name: 'SynoIT', url: 'https://synoit.com/' },
  areaServed: 'Worldwide',
  serviceType: service.category,
  url: `https://synoit.com/services/${service.slug}/`
};
const related = services.filter((item) => item.category === service.category && item.slug !== service.slug).slice(0, 3);
---
<BaseLayout title={`${service.shortTitle} | SynoIT`} description={service.description} canonical={`/services/${service.slug}/`} schema={schema}>
  <main>
    <section class="hero">
      <div class="hero-content">
        <p class="kicker" data-reveal>{service.category}</p>
        <h1 class="hero-title" data-reveal>{service.title}</h1>
        <p class="hero-sub" data-reveal>{service.description}</p>
        <div class="hero-actions" data-reveal>
          <a class="btn-primary" href="mailto:support@synoit.com">Start this project</a>
          <a class="btn-ghost" href="/pricing/">Estimate timeline</a>
        </div>
      </div>
      <HeroNet />
    </section>

    <section class="statement">
      <p data-reveal><span class="dim">{service.proof}</span></p>
    </section>

    <section class="section alt">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="kicker">What we deliver</p>
          <h2>Built around outcomes, not loose activity.</h2>
        </div>
        <div class="grid">
          {service.deliverables.map((item, index) => (
            <div class="card" data-reveal>
              <div class="icon-tile">{String(index + 1).padStart(2, '0')}</div>
              <h3>{item}</h3>
              <p>{service.outcomes[index % service.outcomes.length]} with practical execution, clear documentation, and measurable delivery checkpoints.</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container steps-body">
        <div data-reveal>
          <p class="kicker">{service.processTitle}</p>
          <h2 style="font-size:var(--fs-h2);line-height:1.08;margin-bottom:16px">A focused path from clarity to launch.</h2>
          <div class="step-list">
            {service.process.map((step, index) => (
              <div class="step">
                <div class="step-num">{String(index + 1).padStart(2, '0')}</div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="device" data-reveal>
          <div class="orbit"></div>
          <div class="screen">
            {service.outcomes.slice(0, 3).map((outcome) => (
              <div class="screen-card"><div class="screen-line short"></div><p style="color:var(--muted-2);line-height:1.35;font-size:14px">{outcome}</p></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section pink">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="kicker">Questions, answered</p>
          <h2>What teams usually ask before starting.</h2>
        </div>
        <div class="faq-list" data-reveal>
          {service.faqs.map((faq, index) => (
            <div class:list={['faq-item', index === 0 && 'is-open']}>
              <button aria-expanded={index === 0 ? 'true' : 'false'}>{faq.q}<span>+</span></button>
              <p>{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section blue">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="kicker">Related services</p>
          <h2>Explore adjacent SynoIT capabilities.</h2>
        </div>
        <div class="grid">
          {related.map((item, index) => (
            <a class="card" href={`/services/${item.slug}/`} data-reveal>
              <div class="icon-tile">{String(index + 1).padStart(2, '0')}</div>
              <small>{item.category}</small>
              <h3>{item.shortTitle}</h3>
              <p>{item.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
    <CTA />
  </main>
</BaseLayout>
