---
interface Props {
  compact?: boolean;
  showRole?: boolean;
}

const { compact = false, showRole = false } = Astro.props;
---

<div class:list={["blog-author", { "blog-author--compact": compact }]}>
  <img src="/favicon.svg" width="52" height="52" alt="" aria-hidden="true" />
  <span>
    <strong>SynoIT Editorial Team</strong>
    {showRole && <small>Digital product engineering</small>}
  </span>
</div>
