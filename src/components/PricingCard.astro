---
interface Feature {
  text: string;
  info?: boolean | string;
}

interface Props {
  name: string;
  accent: 'common' | 'rare' | 'epic' | 'legendary';
  price: string;
  cents?: string;
  suffix?: string;
  description: string;
  features: Array<string | Feature>;
  ctaText?: string;
  href?: string;
  active?: boolean;
  index?: number;
}

const {
  name,
  accent,
  price,
  cents = '',
  suffix = '',
  description,
  features,
  ctaText = 'Start Free',
  href = 'mailto:support@synoit.com',
  active = false,
  index = 0
} = Astro.props;

const normalizedFeatures = features.map((feature) => {
  if (typeof feature === 'string') return { text: feature, info: '' };
  return {
    text: feature.text,
    info: typeof feature.info === 'string'
      ? feature.info
      : feature.info
        ? 'The final allowance is confirmed during project discovery.'
        : ''
  };
});

const mediaBase = `/media/pricing/${accent}`;
const cardId = `pricing-tier-${accent}`;
const optionId = `${cardId}-option`;
const checkIcon = 'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIGZpbGw9Im5vbmUiIHZpZXdCb3g9IjAgMCAxNiAxNiI+PHBhdGggc3Ryb2tlPSIjZmZmIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiIHN0cm9rZS13aWR0aD0iMS44MjkiIGQ9Im0xMy4zMyA0LTcuMzMzIDcuMzMzTDIuNjY0IDgiLz48L3N2Zz4=';
---

<article
  id={cardId}
  class:list={['pricing-tier', `pricing-tier--${accent}`, { 'is-active': active }]}
  data-pricing-card
  data-pricing-index={index}
  role="presentation"
>
  <div class="pricing-tier__glow" aria-hidden="true">
    <video
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      data-pricing-video
      data-webm={`${mediaBase}.webm`}
      data-mp4={`${mediaBase}.mp4`}
    ></video>
  </div>

  <img
    class="pricing-tier__surface"
    data-pricing-surface
    data-src={`${mediaBase}.webp`}
    width="390"
    height="529"
    alt=""
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />

  <button
    id={optionId}
    class="pricing-tier__select"
    type="button"
    aria-pressed={active ? 'true' : 'false'}
    aria-label={`Select the ${name} engagement tier, ${price}${cents}${suffix}`}
    tabindex={active ? 0 : -1}
    data-pricing-select
  >
    <span class="pricing-tier__sr-only">Select {name}</span>
  </button>

  <h3>{name}</h3>

  <div class="pricing-tier__price" aria-label={`${price}${cents}${suffix}`}>
    <span>{price}</span>
    {cents && <small>{cents}</small>}
    {suffix && <em>{suffix}</em>}
  </div>

  <p class="pricing-tier__description">{description}</p>
  <span class="pricing-tier__divider" aria-hidden="true"></span>

  <ul>
    {normalizedFeatures.map((feature, featureIndex) => {
      const tooltipId = `${cardId}-tooltip-${featureIndex}`;
      return (
        <li>
          <img class="pricing-tier__check" src={checkIcon} width="16" height="16" alt="" loading="lazy" />
          <span>{feature.text}</span>
          {feature.info && (
            <span class="pricing-tier__info-wrap">
              <button
                class="pricing-tier__info"
                type="button"
                aria-label={`More information about ${feature.text}`}
                aria-controls={tooltipId}
                aria-describedby={tooltipId}
                aria-expanded="false"
                data-pricing-tooltip-button
              >
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path fill="currentColor" d="M8.002 16.004A8.002 8.002 0 1 0 8.002 0a8.002 8.002 0 0 0 0 16.004" opacity=".11"></path>
                  <path fill="#C9CBCF" d="M8.004 4.92c.576 0 .82-.308.82-.73v-.218c0-.423-.244-.73-.82-.73s-.832.307-.832.73v.218c0 .422.256.73.832.73M7.3 12.767h1.395V6.11H7.3v6.658Z"></path>
                </svg>
              </button>
              <span id={tooltipId} class="pricing-tier__tooltip" role="tooltip">{feature.info}</span>
            </span>
          )}
        </li>
      );
    })}
  </ul>

  <a class="pricing-tier__action" href={href}>{ctaText}</a>
</article>

<style>
  .pricing-tier {
    --tier-rgb: 255, 255, 255;
    position: relative;
    z-index: 1;
    isolation: isolate;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    width: 390px;
    aspect-ratio: .7372;
    margin-inline-end: 56px;
    padding: 28px 28px 25px;
    overflow: visible;
    scroll-snap-align: center;
    border: 1px solid rgba(255, 255, 255, .05);
    border-radius: 24px;
    color: #fff;
    background: rgba(30, 28, 38, .42);
    box-shadow: 4px 6px 25px rgba(0, 0, 0, .56);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    text-align: left;
    transition: background-color .2s ease, box-shadow .2s ease;
  }

  .pricing-tier--common { --tier-rgb: 81, 255, 182; }
  .pricing-tier--rare { --tier-rgb: 64, 106, 255; }
  .pricing-tier--epic { --tier-rgb: 244, 120, 255; }
  .pricing-tier--legendary { --tier-rgb: 255, 116, 56; }

  :global(.pricing-carousel.is-font-ready) .pricing-tier {
    font-family: 'Syno Inter', Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .pricing-tier.is-active {
    z-index: 0;
    background: transparent;
    box-shadow: none;
  }

  .pricing-tier__glow,
  .pricing-tier__surface {
    position: absolute;
    pointer-events: none;
    user-select: none;
    opacity: 0;
  }

  .pricing-tier__glow {
    z-index: -2;
    top: -300px;
    left: -70%;
    width: 1000px;
    aspect-ratio: .925925;
    border-radius: inherit;
    clip-path: inset(25% 31% 20.5% 24.5% round 32px);
    contain: layout paint style;
    transition: opacity .42s cubic-bezier(.42, 0, .09, 1);
  }

  .pricing-tier__glow video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    border-radius: inherit;
    object-fit: contain;
  }

  .pricing-tier__surface {
    z-index: -1;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    max-width: none;
    border-radius: inherit;
    transition: opacity .3s cubic-bezier(.42, 0, .09, 1);
  }

  .pricing-tier.is-active .pricing-tier__glow {
    opacity: 1;
    transition-delay: .05s;
  }

  .pricing-tier.is-active .pricing-tier__surface {
    opacity: 1;
  }

  :global(.pricing-carousel.is-centering) .pricing-tier.is-active {
    background: rgba(30, 28, 38, .42);
    box-shadow: 4px 6px 25px rgba(0, 0, 0, .42);
  }

  :global(.pricing-carousel.is-centering) .pricing-tier__glow,
  :global(.pricing-carousel.is-centering) .pricing-tier__surface {
    opacity: 0;
    transition: none;
  }

  .pricing-tier__select {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: inherit;
    outline: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
    touch-action: pan-x pan-y;
  }

  .pricing-tier__select:focus-visible {
    outline: 2px solid rgba(var(--tier-rgb), .95);
    outline-offset: 6px;
  }

  .pricing-tier__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  h3,
  .pricing-tier__price,
  .pricing-tier__description,
  .pricing-tier__divider,
  ul,
  .pricing-tier__action {
    position: relative;
    z-index: 2;
  }

  h3,
  .pricing-tier__price,
  .pricing-tier__description,
  .pricing-tier__divider,
  ul {
    pointer-events: none;
  }

  h3 {
    margin: 0;
    color: #fff;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.375;
    letter-spacing: -.04em;
  }

  .pricing-tier__price {
    display: flex;
    align-items: baseline;
    margin-top: 10px;
    line-height: 1.375;
    white-space: nowrap;
  }

  .pricing-tier__price span {
    color: #fff;
    font-size: 64px;
    font-weight: 600;
    letter-spacing: -.04em;
  }

  .pricing-tier__price small,
  .pricing-tier__price em {
    margin-left: 4px;
    color: #c9cbcf;
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    letter-spacing: -.04em;
  }

  .pricing-tier__price small + em {
    margin-left: 3px;
  }

  .pricing-tier--legendary .pricing-tier__price span {
    font-size: 58px;
  }

  .pricing-tier--legendary .pricing-tier__price em {
    font-size: 18px;
  }

  .pricing-tier__description {
    min-height: 74.25px;
    margin: 4px 0 0;
    padding-right: 12px;
    color: rgba(255, 255, 255, .96);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.375;
    letter-spacing: -.03em;
  }

  .pricing-tier__divider {
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 18px;
    background: rgba(255, 255, 255, .1);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 8px;
    color: rgba(255, 255, 255, .9);
    font-size: 18px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.02em;
    white-space: nowrap;
  }

  .pricing-tier__check {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    opacity: 1;
  }

  .pricing-tier__info-wrap {
    position: relative;
    z-index: 4;
    display: inline-flex;
    margin-left: 4px;
    pointer-events: auto;
  }

  .pricing-tier__info {
    display: inline-grid;
    width: 16px;
    height: 16px;
    padding: 0;
    place-items: center;
    border: 0;
    color: #c9cbcf;
    background: transparent;
    cursor: help;
    transition: color .2s ease;
  }

  .pricing-tier__info:hover,
  .pricing-tier__info:focus-visible,
  .pricing-tier__info[aria-expanded='true'] {
    color: #fff;
  }

  .pricing-tier__info:focus-visible {
    outline: 2px solid rgba(var(--tier-rgb), .9);
    outline-offset: 3px;
    border-radius: 50%;
  }

  .pricing-tier__tooltip {
    position: absolute;
    z-index: 30;
    bottom: calc(100% + 12px);
    left: 50%;
    width: 260px;
    max-width: min(260px, calc(100vw - 32px));
    padding: 18px 16px;
    visibility: hidden;
    border-radius: 12px;
    color: #c9cbcf;
    background: rgba(29, 30, 32, .98);
    box-shadow: 0 14px 24px rgba(0, 0, 0, .9);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.375;
    letter-spacing: 0;
    white-space: normal;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition: opacity .16s ease, transform .16s ease, visibility .16s;
  }

  .pricing-tier__info:focus-visible + .pricing-tier__tooltip,
  .pricing-tier__info-wrap.is-open .pricing-tier__tooltip {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (hover: hover) {
    .pricing-tier__info-wrap:hover .pricing-tier__tooltip {
      visibility: visible;
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .pricing-tier__action {
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 56px;
    margin-top: auto;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 999px;
    color: #fff;
    background: transparent;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.75;
    letter-spacing: -.02em;
    pointer-events: auto;
    transition: color .5s ease, background-color .5s ease, border-color .5s ease;
  }

  .pricing-tier.is-active .pricing-tier__action {
    color: #0b0d10;
    background: #fff;
  }

  .pricing-tier__action:hover,
  .pricing-tier__action:focus-visible {
    border-color: rgba(255, 255, 255, .5);
  }

  .pricing-tier.is-active .pricing-tier__action:hover,
  .pricing-tier.is-active .pricing-tier__action:focus-visible {
    background: rgba(255, 255, 255, .85);
  }

  @media (max-width: 1279px) {
    .pricing-tier {
      margin-inline-end: 48px;
    }

    .pricing-tier__price span {
      font-size: 56px;
    }

    .pricing-tier--legendary .pricing-tier__price span {
      font-size: 54px;
    }

    ul {
      margin-top: 32px;
    }
  }

  @media (max-width: 1023px) {
    .pricing-tier {
      width: 366px;
    }

    .pricing-tier__glow {
      top: -282px;
      width: 932px;
    }

    .pricing-tier__price span {
      font-size: 48px;
    }

    .pricing-tier--legendary .pricing-tier__price span {
      font-size: 46px;
    }

    .pricing-tier__description {
      margin-top: 0;
    }

    ul {
      margin-top: 28px;
    }
  }

  @media (max-width: 767px) {
    .pricing-tier {
      margin-inline-end: 20px;
      padding: 18px;
    }

    .pricing-tier__glow {
      top: -56%;
      left: -68.666%;
      width: 255%;
    }

    .pricing-tier__surface {
      border-radius: 18px;
    }

    h3 {
      font-size: 16px;
    }

    .pricing-tier__price span {
      font-size: 36px;
    }

    .pricing-tier--legendary .pricing-tier__price span {
      font-size: 36px;
    }

    .pricing-tier--legendary .pricing-tier__price em {
      font-size: 16px;
    }

    .pricing-tier__price small,
    .pricing-tier__price em {
      font-size: 16px;
    }

    .pricing-tier__description {
      min-height: 66px;
      padding-right: 0;
      font-size: 16px;
      line-height: 1.375;
    }

    .pricing-tier__divider {
      margin-top: 16px;
    }

    ul {
      gap: 12px;
      margin-top: 16px;
    }

    li {
      gap: 6px;
      font-size: 16px;
      letter-spacing: -.04em;
    }

    .pricing-tier__action {
      height: 40px;
      font-size: 16px;
      line-height: 1.65;
    }
  }

  @media (max-width: 639px) {
    .pricing-tier {
      width: 288px;
    }

    .pricing-tier__tooltip {
      position: fixed;
      right: max(80px, calc(env(safe-area-inset-right) + 80px));
      bottom: 20px;
      left: 16px;
      width: auto;
      max-width: none;
      transform: translateY(8px);
    }

    .pricing-tier__info:focus-visible + .pricing-tier__tooltip,
    .pricing-tier__info-wrap.is-open .pricing-tier__tooltip {
      transform: translateY(0);
    }
  }

  @media (max-width: 639px) and (hover: hover) {
    .pricing-tier__info-wrap:hover .pricing-tier__tooltip {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-tier,
    .pricing-tier__glow,
    .pricing-tier__surface,
    .pricing-tier__action,
    .pricing-tier__tooltip {
      transition: none !important;
    }

    .pricing-tier__glow {
      display: none;
    }

    .pricing-tier__glow video {
      display: none;
    }
  }
</style>
