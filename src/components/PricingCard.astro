---
interface Feature {
  text: string;
  info?: boolean;
}

interface Props {
  name: string;
  accent: 'common' | 'rare' | 'epic' | 'legendary';
  price: string;
  cents?: string;
  suffix?: string;
  description: string;
  features: Array<string | Feature>;
  ctaText?: string;
  href?: string;
  active?: boolean;
}

const {
  name,
  accent,
  price,
  cents = '',
  suffix = '',
  description,
  features,
  ctaText = 'Start Free',
  href = 'mailto:support@synoit.com',
  active = false
} = Astro.props;

const normalizedFeatures = features.map((feature) =>
  typeof feature === 'string' ? { text: feature, info: false } : feature
);
const filterId = `energy-displace-${accent}`;
const glowId = `energy-glow-${accent}`;
const plasmaId = `energy-plasma-${accent}`;
---

<article
  class:list={['energy-card', `energy-card--${accent}`, active && 'is-active']}
  data-pricing-card
  data-reveal
  tabindex="0"
>
  <div class="energy-ambient" aria-hidden="true"></div>

  <svg class="energy-frame" viewBox="0 0 360 700" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id={filterId} x="-42%" y="-28%" width="184%" height="156%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.018 0.115" numOctaves="3" seed="11" result="noise">
          <animate attributeName="baseFrequency" dur="3.2s" values="0.018 0.115;0.032 0.15;0.014 0.09;0.025 0.132;0.018 0.115" repeatCount="indefinite" />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="17" xChannelSelector="R" yChannelSelector="B" />
      </filter>
      <filter id={glowId} x="-70%" y="-48%" width="240%" height="196%" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="8" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id={plasmaId} x="-65%" y="-42%" width="230%" height="184%" color-interpolation-filters="sRGB">
        <feTurbulence type="turbulence" baseFrequency="0.035 0.18" numOctaves="2" seed="19" result="plasmaNoise">
          <animate attributeName="baseFrequency" dur="1.85s" values="0.035 0.18;0.058 0.24;0.025 0.14;0.035 0.18" repeatCount="indefinite" />
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="plasmaNoise" scale="9" xChannelSelector="R" yChannelSelector="G" result="jagged" />
        <feGaussianBlur in="jagged" stdDeviation="1.1" result="softJagged" />
        <feMerge>
          <feMergeNode in="softJagged" />
          <feMergeNode in="jagged" />
        </feMerge>
      </filter>
      <path id={`energy-route-${accent}`} d="M44 18H316Q342 18 342 44V656Q342 682 316 682H44Q18 682 18 656V44Q18 18 44 18Z" />
    </defs>

    <use class="energy-outer-flame" href={`#energy-route-${accent}`} filter={`url(#${glowId})`} />
    <use class="energy-halo-line" href={`#energy-route-${accent}`} />
    <use class="energy-fire-shadow" href={`#energy-route-${accent}`} filter={`url(#${filterId})`} />
    <use class="energy-fire-base" href={`#energy-route-${accent}`} filter={`url(#${filterId})`} />
    <use class="energy-fire-crackle" href={`#energy-route-${accent}`} filter={`url(#${plasmaId})`} />
    <use class="energy-fire-hot energy-fire-hot--a" href={`#energy-route-${accent}`} filter={`url(#${glowId})`} />
    <use class="energy-fire-hot energy-fire-hot--b" href={`#energy-route-${accent}`} filter={`url(#${filterId})`} />
    <use class="energy-fire-hot energy-fire-hot--c" href={`#energy-route-${accent}`} filter={`url(#${plasmaId})`} />
    <use class="energy-fire-filament energy-fire-filament--a" href={`#energy-route-${accent}`} filter={`url(#${filterId})`} />
    <use class="energy-fire-filament energy-fire-filament--b" href={`#energy-route-${accent}`} filter={`url(#${filterId})`} />

    {[0, 1, 2, 3, 4, 5].map((spark) => (
      <circle class={`energy-spark energy-spark--${spark}`} r={spark % 3 === 0 ? 2.5 : 1.6}>
        <animateMotion
          dur={`${3.1 + spark * 0.43}s`}
          begin={`${spark * -0.71}s`}
          repeatCount="indefinite"
          rotate="auto"
        >
          <mpath href={`#energy-route-${accent}`} />
        </animateMotion>
      </circle>
    ))}
  </svg>

  <div class="energy-card__surface">
    <h3>{name}</h3>
    <div class="energy-price" aria-label={`${price}${cents}${suffix}`}>
      <span>{price}</span>
      {cents && <small>{cents}</small>}
      {suffix && <em>{suffix}</em>}
    </div>
    <p class="energy-description">{description}</p>
    <div class="energy-divider" aria-hidden="true"></div>
    <ul>
      {normalizedFeatures.map((feature) => (
        <li>
          <span class="energy-check" aria-hidden="true"></span>
          <span>{feature.text}</span>
          {feature.info && (
            <span class="energy-info" title="Final allowance is confirmed during discovery" aria-label="Final allowance is confirmed during discovery">i</span>
          )}
        </li>
      ))}
    </ul>
    <a class="energy-action" href={href}>{ctaText}</a>
  </div>
</article>

<style>
  .energy-card {
    --energy: #28f2bf;
    --energy-hot: #dffff7;
    --energy-core: #ffffff;
    --energy-deep: #087e67;
    --energy-rgb: 40, 242, 191;
    --energy-deep-rgb: 8, 126, 103;
    --surface-a: #0b1412;
    --surface-b: #080b0b;
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 340px;
    min-width: 0;
    height: clamp(600px, 76vh, 680px);
    margin-inline: auto;
    border-radius: 24px;
    outline: none;
    opacity: .52;
    transform: scale(.982);
    filter: saturate(.72) brightness(.68);
    transition: opacity .36s ease, transform .36s ease, filter .36s ease;
  }

  .energy-card--common {
    --energy: #29f3bd;
    --energy-hot: #dffff6;
    --energy-core: #ffffff;
    --energy-deep: #087c65;
    --energy-rgb: 41, 243, 189;
    --energy-deep-rgb: 8, 124, 101;
    --surface-a: #0d1d19;
    --surface-b: #080b0a;
  }

  .energy-card--rare {
    --energy: #35c9ff;
    --energy-hot: #ebedff;
    --energy-core: #ffffff;
    --energy-deep: #5554ff;
    --energy-rgb: 62, 133, 255;
    --energy-deep-rgb: 36, 80, 190;
    --surface-a: #101936;
    --surface-b: #080c13;
  }

  .energy-card--epic {
    --energy: #ff54dc;
    --energy-hot: #fff0ff;
    --energy-core: #ffffff;
    --energy-deep: #8f31ff;
    --energy-rgb: 217, 66, 255;
    --energy-deep-rgb: 143, 49, 255;
    --surface-a: #241634;
    --surface-b: #0c0910;
  }

  .energy-card--legendary {
    --energy: #ff8b2d;
    --energy-hot: #ffe28a;
    --energy-core: #fff8e7;
    --energy-deep: #d43417;
    --energy-rgb: 255, 120, 34;
    --energy-deep-rgb: 196, 48, 16;
    --surface-a: #23110c;
    --surface-b: #0b0909;
  }

  .energy-ambient {
    position: absolute;
    inset: -52px;
    z-index: -3;
    border-radius: 44px;
    background:
      radial-gradient(ellipse at 50% 2%, rgba(var(--energy-rgb), .72), transparent 45%),
      radial-gradient(ellipse at 98% 58%, rgba(var(--energy-rgb), .46), transparent 50%),
      radial-gradient(ellipse at 10% 70%, rgba(var(--energy-deep-rgb), .38), transparent 48%),
      radial-gradient(ellipse at 50% 110%, rgba(var(--energy-rgb), .28), transparent 54%);
    filter: blur(34px);
    opacity: 0;
    transform: scale(.96);
    transition: opacity .36s ease;
    animation: energyAmbient 4.6s ease-in-out infinite alternate;
    pointer-events: none;
  }

  .energy-frame {
    position: absolute;
    inset: -22px;
    z-index: 3;
    width: calc(100% + 44px);
    height: calc(100% + 44px);
    overflow: visible;
    opacity: 0;
    transition: opacity .28s ease;
    pointer-events: none;
  }

  .energy-frame use,
  .energy-frame circle {
    vector-effect: non-scaling-stroke;
  }

  .energy-outer-flame {
    fill: none;
    stroke: var(--energy-deep);
    stroke-width: 23;
    opacity: .22;
    stroke-linecap: round;
    animation: energyOuter 3.9s ease-in-out infinite alternate;
  }

  .energy-halo-line {
    fill: none;
    stroke: var(--energy);
    stroke-width: 18;
    opacity: .32;
    filter: blur(12px);
  }

  .energy-fire-shadow {
    fill: none;
    stroke: var(--energy-deep);
    stroke-width: 8;
    opacity: .72;
    stroke-linecap: round;
    stroke-dasharray: 96 22 260 48 34 18;
    animation: energyCrawlReverse 6.6s linear infinite, energyBase 2.8s ease-in-out infinite alternate;
  }

  .energy-fire-base {
    fill: none;
    stroke: var(--energy);
    stroke-width: 5.2;
    opacity: .95;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: energyBase 2.45s ease-in-out infinite alternate;
  }

  .energy-fire-crackle {
    fill: none;
    stroke: var(--energy-hot);
    stroke-width: 2.9;
    opacity: .88;
    stroke-linecap: round;
    stroke-dasharray: 2 7 5 11 1 13 38 9;
    animation: energyCrawl 1.6s linear infinite, energySparkPulse .54s steps(2, end) infinite;
  }

  .energy-fire-hot {
    fill: none;
    stroke: var(--energy-core);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .energy-fire-hot--a {
    stroke-width: 4.6;
    stroke-dasharray: 92 28 12 58 185 36 20 110;
    animation: energyCrawl 3.15s linear infinite, energyPulse 1.05s steps(3, end) infinite;
  }

  .energy-fire-hot--b {
    stroke-width: 2.8;
    stroke-dasharray: 11 16 76 20 6 15 118 29 8 38;
    animation: energyCrawlReverse 4.75s linear infinite, energyPulse 1.45s steps(4, end) -.6s infinite;
  }

  .energy-fire-hot--c {
    stroke: var(--energy-hot);
    stroke-width: 6.2;
    opacity: .64;
    stroke-dasharray: 34 180 62 290 12 150;
    animation: energyCrawl 5.85s linear infinite, energySparkPulse .82s steps(2, end) -.2s infinite;
  }

  .energy-fire-filament {
    fill: none;
    stroke-linecap: round;
    opacity: .9;
  }

  .energy-fire-filament--a {
    stroke: var(--energy-hot);
    stroke-width: 1.25;
    stroke-dasharray: 3 8 2 17 48 16;
    animation: energyCrawl 2.05s linear infinite;
  }

  .energy-fire-filament--b {
    stroke: var(--energy-deep);
    stroke-width: 2.4;
    stroke-dasharray: 86 18 18 9 148 24;
    animation: energyCrawlReverse 4.05s linear infinite;
  }

  .energy-spark {
    fill: var(--energy-core);
    opacity: 0;
    filter:
      drop-shadow(0 0 5px var(--energy-hot))
      drop-shadow(0 0 14px var(--energy));
    animation: sparkBlink 1.25s steps(2, end) infinite;
  }

  .energy-spark--1, .energy-spark--4 { animation-delay: -.45s; }
  .energy-spark--2, .energy-spark--5 { animation-delay: -.9s; }

  .energy-card__surface {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.05vw, 28px);
    border: 2px solid color-mix(in srgb, var(--energy) 48%, #f3bf6b 52%);
    border-radius: 24px;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 4%, rgba(255,255,255,.07), transparent 24%),
      radial-gradient(circle at 28% 5%, rgba(var(--energy-rgb), .14), transparent 34%),
      radial-gradient(circle at 102% 100%, rgba(var(--energy-rgb), .11), transparent 45%),
      linear-gradient(148deg, var(--surface-a), var(--surface-b) 58%, #070707);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.055),
      inset 0 -90px 130px rgba(var(--energy-rgb), .045),
      0 26px 82px rgba(0,0,0,.62);
  }

  .energy-card__surface::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: .13;
    background-image: radial-gradient(circle, rgba(255,255,255,.2) .7px, transparent .8px);
    background-size: 9px 9px;
    mask-image: radial-gradient(circle at 72% 13%, #000, transparent 43%);
    pointer-events: none;
  }

  h3,
  .energy-price,
  .energy-description,
  .energy-divider,
  ul,
  .energy-action {
    position: relative;
    z-index: 1;
  }

  h3 {
    margin: 0 0 clamp(42px, 6.1vh, 58px);
    color: #fff;
    font-size: clamp(14px, 1.08vw, 16px);
    line-height: 1;
    font-weight: 560;
  }

  .energy-price {
    display: flex;
    align-items: baseline;
    gap: 2px;
    margin-bottom: clamp(24px, 3.25vh, 32px);
    white-space: nowrap;
  }

  .energy-price span {
    color: #fff;
    font-size: clamp(48px, 4.05vw, 58px);
    line-height: .82;
    font-weight: 680;
  }

  .energy-price small {
    color: rgba(255,255,255,.78);
    font-size: clamp(14px, 1vw, 16px);
    font-weight: 540;
  }

  .energy-price em {
    margin-left: 2px;
    color: rgba(242,242,246,.72);
    font-size: clamp(13px, .95vw, 15px);
    font-style: normal;
    font-weight: 500;
  }

  .energy-description {
    max-width: 28ch;
    min-height: 60px;
    margin: 0;
    color: rgba(246,246,249,.91);
    font-size: clamp(13px, .92vw, 14px);
    line-height: 1.48;
  }

  .energy-divider {
    height: 1px;
    margin: clamp(22px, 3vh, 30px) 0;
    background: rgba(255,255,255,.12);
  }

  ul {
    display: grid;
    gap: clamp(11px, 1.45vh, 14px);
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 11px;
    color: rgba(244,244,247,.92);
    font-size: clamp(13px, .9vw, 14px);
    line-height: 1.25;
    font-weight: 480;
  }

  .energy-check {
    position: relative;
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
  }

  .energy-check::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0;
    width: 6px;
    height: 11px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .energy-info {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    border-radius: 50%;
    color: rgba(255,255,255,.68);
    background: rgba(255,255,255,.11);
    font-size: 11px;
    font-weight: 700;
    cursor: help;
  }

  .energy-action {
    min-height: 52px;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: #090909;
    background: #fff;
    font-size: clamp(15px, .98vw, 16px);
    font-weight: 680;
    box-shadow: 0 2px 0 rgba(0,0,0,.2);
    transition: transform .24s ease, box-shadow .24s ease, background .24s ease;
  }

  .energy-action:hover,
  .energy-action:focus-visible {
    transform: scale(1.015);
    background: #fff;
    box-shadow: 0 8px 28px rgba(255,255,255,.2);
  }

  .energy-card:hover,
  .energy-card:focus-visible,
  .energy-card.is-active {
    opacity: 1;
    transform: scale(1);
    filter: saturate(1.14) brightness(1);
  }

  .energy-card:hover .energy-ambient,
  .energy-card:focus-visible .energy-ambient,
  .energy-card.is-active .energy-ambient,
  .energy-card:hover .energy-frame,
  .energy-card:focus-visible .energy-frame,
  .energy-card.is-active .energy-frame {
    opacity: 1;
  }

  @keyframes energyAmbient {
    0% { transform: scale(.95) translate3d(-1%, 0, 0); filter: blur(38px); }
    55% { transform: scale(1.03) translate3d(1%, -1%, 0); filter: blur(28px); }
    100% { transform: scale(.98) translate3d(0, 1%, 0); filter: blur(42px); }
  }

  @keyframes energyOuter {
    0%, 100% { opacity: .14; stroke-width: 19; }
    36% { opacity: .32; stroke-width: 27; }
    68% { opacity: .22; stroke-width: 22; }
  }

  @keyframes energyBase {
    0%, 100% { opacity: .62; }
    38% { opacity: 1; }
    72% { opacity: .78; }
  }

  @keyframes energyCrawl { to { stroke-dashoffset: -720; } }
  @keyframes energyCrawlReverse { to { stroke-dashoffset: 840; } }

  @keyframes energyPulse {
    0%, 100% { opacity: .48; }
    18% { opacity: 1; }
    46% { opacity: .68; }
    72% { opacity: .92; }
  }

  @keyframes energySparkPulse {
    0%, 100% { opacity: .28; }
    18% { opacity: 1; }
    24% { opacity: .45; }
    42% { opacity: .9; }
    58% { opacity: .18; }
    76% { opacity: .72; }
  }

  @keyframes sparkBlink {
    0%, 22%, 100% { opacity: 0; }
    28%, 39% { opacity: 1; }
    44%, 78% { opacity: .2; }
  }

  @media (max-height: 820px) and (min-width: 981px) {
    .energy-card { height: 600px; }
    .energy-card__surface { padding: 24px; }
    h3 { margin-bottom: 42px; }
    .energy-price { margin-bottom: 24px; }
    .energy-description { min-height: 58px; }
    .energy-divider { margin: 22px 0; }
    ul { gap: 11px; margin-bottom: 22px; }
  }

  @media (max-width: 980px) {
    .energy-card { height: 560px; }
  }

  @media (max-width: 640px) {
    .energy-card {
      width: min(100%, 340px);
      height: 600px;
      min-height: 560px;
      margin-inline: auto;
      opacity: 1;
      transform: none;
      filter: saturate(1) brightness(1);
    }
    .energy-frame { inset: -12px; width: calc(100% + 24px); height: calc(100% + 24px); }
    .energy-ambient { inset: -22px; filter: blur(20px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .energy-ambient,
    .energy-frame use,
    .energy-spark {
      animation: none !important;
    }
    .energy-fire-hot--a { stroke-dasharray: 420 70; }
    .energy-fire-hot--b,
    .energy-fire-filament { opacity: .45; }
    .energy-spark { display: none; }
  }
</style>
