---
interface Feature {
  text: string;
  info?: boolean;
}

interface Props {
  name: string;
  accent: 'common' | 'rare' | 'epic' | 'legendary';
  price: string;
  cents?: string;
  suffix?: string;
  description: string;
  features: Array<string | Feature>;
  ctaText?: string;
  href?: string;
  active?: boolean;
}

const {
  name,
  accent,
  price,
  cents = '',
  suffix = '',
  description,
  features,
  ctaText = 'Start Free',
  href = 'mailto:support@synoit.com',
  active = false
} = Astro.props;

const normalizedFeatures = features.map((feature) =>
  typeof feature === 'string' ? { text: feature, info: false } : feature
);
const pathId = `pricing-orbit-${accent}`;
const smokeMaskId = `pricing-smoke-mask-${accent}`;
---

<article class:list={['pricing-tier', `pricing-tier--${accent}`, { 'is-active': active }]} data-pricing-card data-reveal tabindex="0">
  <span class="pricing-tier__glow" aria-hidden="true"></span>
  <svg class="pricing-tier__storm" viewBox="0 0 390 530" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <mask id={smokeMaskId}>
        <rect x="-80" y="-80" width="550" height="690" fill="white" />
        <rect x="26" y="26" width="338" height="478" rx="24" fill="black" />
      </mask>
      <path id={pathId} d="M52 24H338Q366 24 366 52V478Q366 506 338 506H52Q24 506 24 478V52Q24 24 52 24Z" />
    </defs>
    <g mask={`url(#${smokeMaskId})`}>
      <use class="storm-line storm-line--base" href={`#${pathId}`} />
      <use class="storm-line storm-line--wide-a" href={`#${pathId}`} />
      <use class="storm-line storm-line--wide-b" href={`#${pathId}`} />
      <use class="storm-line storm-line--hot-a" href={`#${pathId}`} />
      <use class="storm-line storm-line--hot-b" href={`#${pathId}`} />
      <use class="storm-line storm-line--sparkle" href={`#${pathId}`} />
    </g>
  </svg>

  <h3>{name}</h3>

  <div class="pricing-tier__price" aria-label={`${price}${cents}${suffix}`}>
    <span>{price}</span>
    {cents && <small>{cents}</small>}
    {suffix && <em>{suffix}</em>}
  </div>

  <p class="pricing-tier__description">{description}</p>
  <span class="pricing-tier__divider" aria-hidden="true"></span>

  <ul>
    {normalizedFeatures.map((feature) => (
      <li>
        <span class="pricing-tier__check" aria-hidden="true"></span>
        <span>{feature.text}</span>
        {feature.info && (
          <span class="pricing-tier__info" title="Final allowance is confirmed during discovery" aria-label="Final allowance is confirmed during discovery">i</span>
        )}
      </li>
    ))}
  </ul>

  <a class="pricing-tier__action" href={href}>{ctaText}</a>
</article>

<style>
  .pricing-tier {
    --tier-rgb: 255, 255, 255;
    --tier-hot: #ffffff;
    --tier-core: #ffffff;
    --tier-deep: #ffffff;
    --tier-surface: #0d0f11;
    --tier-border: rgba(255, 255, 255, .055);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    width: min(100%, 320px);
    min-height: 448px;
    padding: 20px;
    border: 1px solid var(--tier-border);
    border-radius: 24px;
    overflow: hidden;
    color: #fff;
    background:
      linear-gradient(180deg, rgba(18, 20, 23, .98), rgba(9, 10, 12, .98)),
      var(--tier-surface);
    box-shadow: 4px 6px 25px rgba(0, 0, 0, .56);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    contain: layout paint;
    cursor: pointer;
    scroll-snap-align: center;
    outline: none;
    transition:
      transform .2s ease,
      border-color .2s ease,
      background .2s ease,
      box-shadow .2s ease,
      opacity .2s ease;
  }

  .pricing-tier--common {
    --tier-rgb: 42, 243, 190;
    --tier-hot: #e8fff8;
    --tier-core: #ffffff;
    --tier-deep: #19a87d;
  }

  .pricing-tier--rare {
    --tier-rgb: 75, 148, 255;
    --tier-hot: #eef6ff;
    --tier-core: #ffffff;
    --tier-deep: #315dff;
  }

  .pricing-tier--epic {
    --tier-rgb: 218, 76, 255;
    --tier-hot: #fff0ff;
    --tier-core: #ffffff;
    --tier-deep: #9b36ff;
  }

  .pricing-tier--legendary {
    --tier-rgb: 255, 134, 42;
    --tier-hot: #ffd36f;
    --tier-core: #fff8df;
    --tier-deep: #c83212;
    --tier-border: rgba(255, 255, 255, .1);
    --tier-surface: #20120d;
  }

  .pricing-tier__glow,
  .pricing-tier__storm {
    position: absolute;
    pointer-events: none;
    opacity: 0;
    transition: opacity .26s ease, transform .26s ease;
  }

  .pricing-tier__glow {
    inset: -28px;
    z-index: -1;
    border-radius: 42px;
    background:
      radial-gradient(circle at 18% 0%, rgba(var(--tier-rgb), .72), transparent 34%),
      radial-gradient(circle at 88% 44%, rgba(var(--tier-rgb), .36), transparent 48%),
      radial-gradient(circle at 92% 105%, rgba(var(--tier-rgb), .46), transparent 42%);
    filter: blur(22px);
    transform: scale(.96);
    animation: tierGlowBreath 5.8s ease-in-out infinite alternate;
    animation-play-state: paused;
  }

  .pricing-tier__storm {
    inset: -13px;
    z-index: 4;
    width: calc(100% + 26px);
    height: calc(100% + 26px);
    overflow: visible;
  }

  .pricing-tier__storm use,
  .pricing-tier__storm path,
  .pricing-tier__storm ellipse,
  .pricing-tier__storm circle {
    vector-effect: non-scaling-stroke;
  }

  .storm-line {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation-play-state: paused !important;
  }

  .storm-line--base {
    stroke: rgb(var(--tier-rgb));
    stroke-width: 6.2;
    opacity: .9;
    filter:
      drop-shadow(0 0 8px rgb(var(--tier-rgb)))
      drop-shadow(0 0 22px rgba(var(--tier-rgb), .52));
    animation: stormBasePulse 5.2s ease-in-out infinite alternate;
  }

  .storm-line--wide-a,
  .storm-line--wide-b {
    stroke: rgb(var(--tier-rgb));
    opacity: .55;
    filter:
      drop-shadow(0 0 10px rgb(var(--tier-rgb)))
      drop-shadow(0 0 34px rgba(var(--tier-rgb), .55));
  }

  .storm-line--wide-a {
    stroke-width: 7.4;
    stroke-dasharray: 520 420 310 360 780 540;
    animation: stormDash 15s linear infinite, stormSmokePulse 8.8s ease-in-out infinite alternate;
  }

  .storm-line--wide-b {
    stroke: var(--tier-hot);
    stroke-width: 5;
    stroke-dasharray: 260 360 640 520 180 430;
    opacity: .34;
    animation: stormDashReverse 16s linear infinite, stormCrackle 3s steps(3, end) -.35s infinite;
  }

  .storm-line--hot-a {
    stroke: var(--tier-core);
    stroke-width: 4.6;
    stroke-dasharray: 520 160 310 170 760 220;
    filter:
      drop-shadow(0 0 5px var(--tier-hot))
      drop-shadow(0 0 18px rgb(var(--tier-rgb)));
    animation: stormDash 9.8s linear infinite, stormCrackle 2.2s steps(3, end) infinite;
  }

  .storm-line--hot-b {
    stroke: var(--tier-hot);
    stroke-width: 3;
    stroke-dasharray: 70 110 260 130 62 150 430 180;
    opacity: .92;
    animation: stormDashReverse 12s linear infinite, stormCrackle 2.4s steps(2, end) -.2s infinite;
  }

  .storm-line--sparkle {
    stroke: var(--tier-core);
    stroke-width: 1.6;
    stroke-dasharray: 24 70 14 120 36 95 210 130;
    opacity: .78;
    filter: drop-shadow(0 0 7px var(--tier-hot));
    animation: stormDash 7.2s linear infinite, stormCrackle 1.8s steps(2, end) infinite;
  }

  h3,
  .pricing-tier__price,
  .pricing-tier__description,
  .pricing-tier__divider,
  ul,
  .pricing-tier__action {
    position: relative;
    z-index: 2;
  }

  h3 {
    margin: 0;
    color: #fff;
    font-size: 20px;
    line-height: 1.18;
    font-weight: 650;
    letter-spacing: 0;
  }

  .pricing-tier__price {
    display: flex;
    align-items: baseline;
    margin-top: 10px;
    line-height: 1.1;
    white-space: nowrap;
  }

  .pricing-tier__price span {
    color: #fff;
    font-size: clamp(36px, 3.4vw, 50px);
    line-height: .95;
    font-weight: 650;
    letter-spacing: -2px;
  }

  .pricing-tier__price small,
  .pricing-tier__price em {
    color: #c9cbcf;
    font-weight: 520;
    letter-spacing: 0;
  }

  .pricing-tier__price small {
    font-size: clamp(16px, 1.45vw, 20px);
  }

  .pricing-tier__price em {
    margin-left: 4px;
    font-size: clamp(16px, 1.45vw, 20px);
    font-style: normal;
  }

  .pricing-tier__description {
    min-height: 54px;
    margin: 4px 0 0;
    padding-right: 12px;
    color: rgba(255, 255, 255, .9);
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.34;
    font-weight: 520;
    letter-spacing: 0;
  }

  .pricing-tier__divider {
    display: block;
    width: 100%;
    height: 1px;
    margin-top: 18px;
    background: rgba(255, 255, 255, .1);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 18px 0 20px;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: rgba(255, 255, 255, .9);
    font-size: clamp(14px, 1.08vw, 16px);
    line-height: 1;
    font-weight: 520;
    letter-spacing: 0;
  }

  .pricing-tier__check {
    position: relative;
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    opacity: .75;
  }

  .pricing-tier__check::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 1px;
    width: 6px;
    height: 11px;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .pricing-tier__info {
    display: inline-grid;
    place-items: center;
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    border-radius: 50%;
    color: rgba(255,255,255,.65);
    background: rgba(255,255,255,.12);
    font-size: 11px;
    font-weight: 700;
    cursor: help;
  }

  .pricing-tier__action {
    min-height: 44px;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 999px;
    color: #fff;
    background: transparent;
    font-size: clamp(14px, 1.08vw, 16px);
    line-height: 1;
    font-weight: 680;
    text-transform: capitalize;
    transition: background .3s ease, border-color .3s ease, color .3s ease, transform .3s ease;
  }

  .pricing-tier--legendary .pricing-tier__action,
  .pricing-tier:hover .pricing-tier__action,
  .pricing-tier:focus-visible .pricing-tier__action,
  .pricing-tier.is-active .pricing-tier__action {
    border-color: #fff;
    color: #0b0d10;
    background: #fff;
  }

  .pricing-tier:hover,
  .pricing-tier:focus-visible,
  .pricing-tier.is-active {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, .16);
    box-shadow:
      4px 6px 25px rgba(0, 0, 0, .56),
      0 0 50px rgba(var(--tier-rgb), .16);
  }

  .pricing-tier:hover .pricing-tier__glow,
  .pricing-tier:focus-visible .pricing-tier__glow,
  .pricing-tier.is-active .pricing-tier__glow {
    opacity: 1;
    transform: scale(1);
    animation-play-state: running;
  }

  .pricing-tier:hover .pricing-tier__storm,
  .pricing-tier:focus-visible .pricing-tier__storm,
  .pricing-tier.is-active .pricing-tier__storm {
    opacity: 1;
  }

  .pricing-tier:hover .storm-line,
  .pricing-tier:focus-visible .storm-line,
  .pricing-tier.is-active .storm-line {
    animation-play-state: running !important;
  }

  .pricing-tier__action:hover,
  .pricing-tier__action:focus-visible {
    transform: scale(1.01);
    border-color: rgba(255,255,255,.5);
    background: rgba(255,255,255,.95);
    color: #0b0d10;
  }

  @keyframes tierGlowBreath {
    0% { transform: scale(.96) translate3d(-1%, 0, 0); filter: blur(38px); }
    48% { transform: scale(1.03) translate3d(1%, -1%, 0); filter: blur(28px); }
    100% { transform: scale(.99) translate3d(0, 1%, 0); filter: blur(44px); }
  }

  @keyframes stormBasePulse {
    0%, 100% { opacity: .6; stroke-width: 5; }
    46% { opacity: 1; stroke-width: 8; }
    72% { opacity: .82; stroke-width: 6.2; }
  }

  @keyframes stormDash {
    to { stroke-dashoffset: -1960; }
  }

  @keyframes stormDashReverse {
    to { stroke-dashoffset: 2080; }
  }

  @keyframes stormSmokePulse {
    0%, 100% { opacity: .08; }
    52% { opacity: .22; }
  }

  @keyframes stormCrackle {
    0%, 100% { opacity: .46; }
    20% { opacity: 1; }
    38% { opacity: .62; }
    64% { opacity: .95; }
  }

  @media (max-width: 720px) {
    .pricing-tier {
      width: min(310px, calc(100vw - 40px));
      min-height: 428px;
      padding: 20px;
    }

    .pricing-tier__price span {
      font-size: 38px;
      letter-spacing: -1.2px;
    }

    .pricing-tier__price small,
    .pricing-tier__price em {
      font-size: 14px;
    }

    .pricing-tier__action {
      min-height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-tier__glow,
    .storm-line {
      animation: none !important;
    }
  }
</style>
