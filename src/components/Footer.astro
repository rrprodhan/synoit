---
import { categories, services } from '@/data/services';
const year = new Date().getFullYear();
const byCategory = categories.map((category) => ({
  category,
  items: services.filter((service) => service.category === category)
}));
---
<footer class="site-footer">
  <div class="site-footer__shell">
    <section class="site-footer__cta" aria-labelledby="footer-cta-title">
      <div>
        <p class="site-footer__eyebrow">HAVE A PRODUCT IN MIND?</p>
        <h2 id="footer-cta-title">Let’s move it <span>forward.</span></h2>
      </div>
      <a class="site-footer__cta-link" href="/contact/">
        <span>Start a conversation</span><b aria-hidden="true">↗</b>
      </a>
    </section>

    <div class="site-footer__main">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href="/" aria-label="SynoIT home">
          <span class="site-footer__mark" aria-hidden="true">S</span><strong>SynoIT</strong>
        </a>
        <p>One connected team for product strategy, design, engineering, practical AI, and measurable digital growth.</p>
        <div class="site-footer__contact">
          <span>Drop us a line</span>
          <a href="mailto:support@synoit.com">support@synoit.com</a>
          <span>Call or WhatsApp</span>
          <a href="https://wa.me/6582034346" target="_blank" rel="noopener">+65 8203 4346</a>
        </div>
      </div>

      <nav class="site-footer__nav" aria-label="Footer navigation">
        <div>
          <h3>Explore</h3>
          <a href="/">Home</a>
          <a href="/projects/">Projects</a>
          <a href="/pricing/">Pricing</a>
          <a href="/dedicated-team/">Dedicated team</a>
        </div>
        <div>
          <h3>Resources</h3>
          <a href="/blog/">Blog</a>
          <a href="/templates/">Templates</a>
          <a href="/contact/">Contact</a>
        </div>
        <div>
          <h3>Capabilities</h3>
          {byCategory.map((group) => (
            <a href={`/services/${group.items[0]?.slug}/`}>{group.category}</a>
          ))}
        </div>
      </nav>
    </div>

    <details class="site-footer__directory">
      <summary><span>Explore all services</span><span aria-hidden="true">+</span></summary>
      <div class="site-footer__services">
        {byCategory.map((group) => (
          <div>
            <h3>{group.category}</h3>
            {group.items.map((item) => <a href={`/services/${item.slug}/`}>{item.shortTitle}</a>)}
          </div>
        ))}
      </div>
    </details>

    <div class="site-footer__bottom">
      <span>© {year} SynoIT. All rights reserved.</span>
      <span>Singapore HQ · Bangladesh Hub · Global delivery</span>
      <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position:relative;
    z-index:3;
    min-width:0;
    padding:clamp(56px,8vw,112px) clamp(18px,5vw,72px) max(32px,env(safe-area-inset-bottom));
    overflow:hidden;
    border-top:1px solid rgba(234,234,240,.09);
    color:#eaeaf0;
    background:
      radial-gradient(circle at 12% 0%,rgba(154,138,251,.18),transparent 34%),
      radial-gradient(circle at 92% 18%,rgba(204,51,102,.1),transparent 32%),
      linear-gradient(180deg,#111016 0%,#0b0a0e 100%);
  }
  .site-footer::before {
    content:'';
    position:absolute;
    inset:0;
    pointer-events:none;
    opacity:.35;
    background-image:linear-gradient(rgba(154,138,251,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(154,138,251,.05) 1px,transparent 1px);
    background-size:72px 72px;
    mask-image:linear-gradient(180deg,#000,transparent 72%);
  }
  .site-footer__shell { position:relative; width:min(100%,1320px); margin:0 auto; }
  .site-footer__cta {
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:32px;
    padding-bottom:clamp(42px,6vw,76px);
    border-bottom:1px solid rgba(234,234,240,.13);
  }
  .site-footer__eyebrow {
    margin:0 0 14px;
    color:#9a8afb;
    font-size:clamp(11px,1vw,13px);
    font-weight:800;
    letter-spacing:.28em;
  }
  .site-footer h2 {
    max-width:820px;
    margin:0;
    color:#eaeaf0;
    font-size:clamp(42px,7vw,94px);
    font-weight:600;
    line-height:.96;
    letter-spacing:-.05em;
  }
  .site-footer h2 span { color:#9a8afb; }
  .site-footer__cta-link {
    display:flex;
    flex:0 0 auto;
    align-items:center;
    justify-content:space-between;
    gap:22px;
    min-width:min(100%,260px);
    min-height:62px;
    padding:12px 15px 12px 24px;
    border:1px solid rgba(154,138,251,.42);
    border-radius:999px;
    color:#eaeaf0;
    background:rgba(154,138,251,.1);
    box-shadow:0 18px 50px rgba(0,0,0,.28);
    font-size:15px;
    font-weight:700;
    text-decoration:none;
    transition:transform .25s,border-color .25s,background .25s;
  }
  .site-footer__cta-link b {
    display:grid;
    width:38px;
    height:38px;
    place-items:center;
    border-radius:50%;
    color:#100e14;
    background:#9a8afb;
    font-size:17px;
  }
  .site-footer__cta-link:hover { transform:translateY(-3px); border-color:#9a8afb; background:rgba(154,138,251,.17); }
  .site-footer__main {
    display:grid;
    grid-template-columns:minmax(260px,1.05fr) minmax(420px,1.45fr);
    gap:clamp(44px,8vw,120px);
    padding:clamp(42px,6vw,76px) 0;
  }
  .site-footer__logo { display:inline-flex; align-items:center; gap:12px; color:#eaeaf0; text-decoration:none; }
  .site-footer__logo strong { font-size:22px; letter-spacing:-.02em; }
  .site-footer__mark {
    display:grid;
    width:44px;
    height:44px;
    place-items:center;
    border:1px solid rgba(255,255,255,.28);
    border-radius:13px;
    color:#fff;
    background:linear-gradient(145deg,#bca9ff,#8f7bf7 45%,#6a4ee8);
    box-shadow:inset 0 1px 4px rgba(255,255,255,.38),0 0 28px rgba(154,138,251,.4);
    font-size:25px;
    font-weight:700;
  }
  .site-footer__brand > p { max-width:440px; margin:22px 0 28px; color:#bdb7cb; font-size:15px; line-height:1.7; }
  .site-footer__contact { display:grid; grid-template-columns:max-content minmax(0,1fr); gap:8px 18px; align-items:baseline; }
  .site-footer__contact span { color:#7f788e; font-size:11px; letter-spacing:.14em; text-transform:uppercase; }
  .site-footer__contact a { min-width:0; color:#eaeaf0; font-size:15px; overflow-wrap:anywhere; text-decoration:none; }
  .site-footer__contact a:hover { color:#9a8afb; }
  .site-footer__nav { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px; }
  .site-footer h3 { margin:0 0 18px; color:#817a91; font-size:11px; font-weight:800; letter-spacing:.2em; text-transform:uppercase; }
  .site-footer__nav a,.site-footer__services a {
    display:block;
    width:fit-content;
    margin:9px 0;
    color:#c9c4d3;
    font-size:14px;
    line-height:1.45;
    text-decoration:none;
    transition:color .2s,transform .2s;
  }
  .site-footer__nav a:hover,.site-footer__services a:hover { color:#fff; transform:translateX(3px); }
  .site-footer__proof {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:10px;
    padding:12px 0 clamp(34px,5vw,58px);
  }
  .site-footer__proof span {
    display:flex;
    min-height:70px;
    align-items:center;
    gap:10px;
    padding:14px 16px;
    border:1px solid rgba(234,234,240,.09);
    border-radius:15px;
    color:#9c95aa;
    background:rgba(255,255,255,.025);
    font-size:12px;
  }
  .site-footer__proof strong { color:#eaeaf0; font-size:18px; }
  .site-footer__directory { border-top:1px solid rgba(234,234,240,.13); border-bottom:1px solid rgba(234,234,240,.13); }
  .site-footer__directory summary {
    display:flex;
    min-height:74px;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    color:#eaeaf0;
    cursor:pointer;
    list-style:none;
    font-size:17px;
    font-weight:700;
  }
  .site-footer__directory summary::-webkit-details-marker { display:none; }
  .site-footer__directory summary span:last-child { color:#9a8afb; font-size:27px; font-weight:400; transition:transform .25s; }
  .site-footer__directory[open] summary span:last-child { transform:rotate(45deg); }
  .site-footer__services { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:28px; padding:8px 0 42px; }
  .site-footer__bottom {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    padding-top:24px;
    color:#797282;
    font-size:12px;
  }
  .site-footer__bottom a { display:inline-flex; align-items:center; gap:8px; color:#bdb7c8; text-decoration:none; }
  .site-footer__bottom a:hover { color:#fff; }
  @media (max-width:900px) {
    .site-footer__cta { align-items:flex-start; flex-direction:column; }
    .site-footer__main { grid-template-columns:1fr; }
    .site-footer__proof { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .site-footer__services { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media (max-width:560px) {
    .site-footer { padding-inline:18px; padding-bottom:max(104px,env(safe-area-inset-bottom)); }
    .site-footer::before { background-size:48px 48px; }
    .site-footer__cta-link { width:100%; }
    .site-footer__nav { grid-template-columns:repeat(2,minmax(0,1fr)); gap:30px 18px; }
    .site-footer__nav > div:last-child { grid-column:1 / -1; }
    .site-footer__contact { grid-template-columns:1fr; gap:5px; }
    .site-footer__contact span:not(:first-child) { margin-top:10px; }
    .site-footer__proof { grid-template-columns:1fr; }
    .site-footer__proof span { min-height:58px; }
    .site-footer__services { grid-template-columns:1fr; }
    .site-footer__bottom { align-items:flex-start; flex-direction:column; }
  }
</style>
