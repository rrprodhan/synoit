---
import '../styles/home.css';
import { categories, services } from '@/data/services';
import {
  AppWindow,
  Badge,
  Bot,
  BrainCircuit,
  ClipboardCheck,
  Cloud,
  CloudCog,
  Code2,
  FileCode2,
  Globe2,
  Megaphone,
  Monitor,
  Network,
  Palette,
  PanelsTopLeft,
  Presentation,
  RefreshCw,
  Rocket,
  Smartphone,
  TrendingUp,
  WandSparkles,
  Workflow
} from '@lucide/astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  schema?: Record<string, unknown>;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = '/og.svg',
  schema,
  ogType = 'website',
  publishedTime,
  modifiedTime
} = Astro.props;

const site = 'https://synoit.com';
const canonicalUrl = new URL(canonical, site).toString();
const imageUrl = new URL(image, site).toString();
const year = new Date().getFullYear();
const byCategory = categories.map((category) => ({
  category,
  items: services.filter((service) => service.category === category)
}));
const serviceIcons: Record<string, typeof Monitor> = {
  'web-design': Monitor,
  'web-development': Globe2,
  'ui-ux-design': Palette,
  'product-audit': ClipboardCheck,
  'landing-page-design': PanelsTopLeft,
  branding: Badge,
  'mobile-app-design': Smartphone,
  rebranding: RefreshCw,
  'pitch-deck-design': Presentation,
  'software-development': Code2,
  'webflow-development': Workflow,
  'mobile-app-development': AppWindow,
  'mvp-development': Rocket,
  'chatbot-development': Bot,
  'ai-automation': WandSparkles,
  'ai-agent': BrainCircuit,
  'ai-saas': CloudCog,
  'ai-integration': Network,
  'cms-development': FileCode2,
  'cloud-app-development': Cloud,
  'social-media-marketing': Megaphone,
  seo: TrendingUp
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#110F14" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="SynoIT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.svg" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <style is:global>
      /* Only image-dependent pieces are replaced. The design rules above are
         loaded verbatim from the supplied reference stylesheet. */
      .brand-mark,
      .visual-mark {
        display:grid;
        place-items:center;
        color:#fff;
        font-weight:700;
        background:linear-gradient(145deg,#bca9ff 0%,#8f7bf7 45%,#6a4ee8 100%);
      }
      .nav-logo .brand-mark { width:30px; height:30px; border-radius:9px; box-shadow:0 0 22px rgba(154,138,251,.45); }
      .brand-mark { animation:markBreath 3.6s ease-in-out infinite; }
      .app-chip .visual-mark { width:52%; aspect-ratio:1; background:none; font-size:clamp(25px,4vw,52px); animation:logoBreath 3.6s ease-in-out infinite; }
      .hero-phone { width:clamp(175px,24vh,240px); aspect-ratio:.72; margin:-28px auto -30px; }
      .hero-device {
        width:100%; height:100%; padding:11px; border-radius:46px;
        background:linear-gradient(160deg,#3b3a44,#17161c 30%,#0b0a0e 72%,#2c2b34);
        border:1px solid rgba(255,255,255,.18);
        box-shadow:inset 0 0 4px rgba(255,255,255,.22),0 34px 80px rgba(0,0,0,.6),0 0 60px rgba(124,92,240,.28);
      }
      .hero-device-screen,.device-screen {
        height:100%; overflow:hidden; position:relative; padding:24px 15px;
        border-radius:37px; background:linear-gradient(160deg,#201b38,#0d0b13 68%);
      }
      .hero-device-screen::before,.device-screen::before { content:'SynoIT'; display:block; color:var(--violet); font-size:17px; font-weight:600; letter-spacing:.08em; }
      .hero-device-screen::after,.device-screen::after { content:''; display:block; height:58%; margin-top:24px; border-radius:24px; background:radial-gradient(circle at 50% 38%,rgba(154,138,251,.55),rgba(154,138,251,.08) 38%,transparent 66%),linear-gradient(160deg,rgba(255,255,255,.08),transparent); border:1px solid var(--line); }
      .step-video { width:100%; height:100%; left:0; top:0; padding:34px 24px; background:linear-gradient(160deg,#221c3d,#0b0a0e); }
      .step-video strong { display:block; color:var(--violet); font-size:14px; letter-spacing:.12em; }
      .step-video b { display:block; margin:28px 0 12px; font-size:28px; }
      .step-video span { display:block; height:10px; margin-top:14px; border-radius:100px; background:linear-gradient(90deg,rgba(154,138,251,.75),rgba(234,234,240,.07)); }
      .step-video span:nth-of-type(2) { width:72%; }.step-video span:nth-of-type(3) { width:48%; }
      .store-btn > .service-icon,.imagine-points .point-icon {
        width:44px; height:44px; flex:0 0 44px; display:grid; place-items:center;
        border-radius:13px; color:var(--violet); background:var(--violet-dim);
        border:1px solid rgba(154,138,251,.3); font-size:12px; font-weight:700; letter-spacing:.08em;
      }
      .sig-phone { min-height:520px; align-items:center; }
      .sig-device,.imagine-device {
        position:relative; width:min(330px,78vw); aspect-ratio:1284/2778; margin:0 auto; padding:11px;
        border-radius:52px; background:linear-gradient(160deg,#3b3a44,#17161c 30%,#0b0a0e 72%,#2c2b34);
        border:1px solid rgba(255,255,255,.18);
        box-shadow:inset 0 0 4px rgba(255,255,255,.22),0 34px 80px rgba(0,0,0,.6),0 0 60px rgba(124,92,240,.28);
        will-change:transform;
      }
      .sig-device .device-screen,.imagine-device .device-screen { border-radius:42px; }
      .sig-device .device-screen::after { height:70%; }
      .sig-phone img,.imagine-device img { display:none; }
      .i-tile .inside-icon { width:48px; height:48px; display:grid; place-items:center; border-radius:14px; color:var(--violet); background:var(--violet-dim); border:1px solid rgba(154,138,251,.3); font-weight:700; }
      .service-marquee-track { display:flex; gap:18px; width:max-content; will-change:transform; }
      .service-marquee-track .lang-chip::before { content:'✦'; color:var(--violet); }
      .price-amount.price-copy { font-size:clamp(42px,6vw,68px); }
      .price-amount.price-copy span { display:block; margin-top:8px; font-size:.3em; }
      .qr-box { max-width:720px; }
      .qr-pair { width:100%; }
      .qr-tile { flex:1; min-height:160px; padding:25px; justify-content:center; border:1px solid var(--line); border-radius:20px; background:linear-gradient(160deg,rgba(30,28,38,.92),rgba(21,19,26,.92)); }
      .qr-tile strong { color:var(--violet); font-size:clamp(30px,5vw,52px); }
      .qr-tile span { color:var(--muted-2); }
      .footer .brand-mark { width:34px; height:34px; border-radius:10px; opacity:.9; }
      @media (max-width:900px) {
        .sig-phone { min-height:auto; }
        .sig-device { width:min(280px,74vw); }
      }
      @media (max-width:640px) {
        .nav-logo .brand-mark { width:26px; height:26px; border-radius:8px; }
        .hero-device { border-radius:38px; }
        .hero-device-screen { border-radius:30px; }
        .service-marquee-track .lang-chip { padding:13px 22px; }
      }
    </style>
    <script>history.scrollRestoration = 'manual'; window.scrollTo(0, 0);</script>
  </head>
  <body>
    <canvas id="gl" aria-hidden="true"></canvas>
    <div class="vignette" aria-hidden="true"></div>
    <canvas id="grain" aria-hidden="true"></canvas>
    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
    <a class="whatsapp-float" href="https://wa.me/6582034346" target="_blank" rel="noopener" aria-label="Chat with SynoIT on WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.6A12.2 12.2 0 0 0 5.5 22l-1.7 6.2 6.4-1.7A12.2 12.2 0 1 0 16 3.6Zm0 2.4a9.8 9.8 0 0 1 0 19.6c-1.7 0-3.3-.4-4.7-1.2l-.5-.3-3.5.9.9-3.4-.3-.5A9.8 9.8 0 0 1 16 6Zm-4.2 5.2c-.2 0-.5 0-.7.3-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.2 3.2c.2.2 2.2 3.5 5.4 4.7 2.7 1.1 3.2.8 3.8.8.6-.1 1.9-.8 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.7-.5l-2.1-1c-.3-.1-.6-.2-.8.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.8.1-.4-.2-1.5-.6-2.8-1.7-1-1-1.7-2.1-1.9-2.4-.2-.4 0-.6.2-.8l.5-.6c.2-.2.2-.3.3-.6.1-.2.1-.4 0-.6l-1-2.3c-.2-.6-.5-.6-.8-.6Z"/></svg></a>
    <div class="cursor" id="cursor" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="13" stroke="rgba(180,166,255,.55)" stroke-width="1.6"/><circle cx="20" cy="20" r="5.5" fill="#CFC4FF"/><circle cx="20" cy="20" r="2.6" fill="#FFFFFF"/></svg></div>

    <nav class="nav" id="nav" aria-label="Primary navigation">
      <a href="/" class="nav-logo" aria-label="SynoIT home"><span class="brand-mark">S</span><span>SynoIT</span></a>
      <div class="nav-right">
        <div class="services-wrap">
          <button class="nav-link" aria-haspopup="true" aria-expanded="false">Services</button>
          <div class="mega">
            {byCategory.map((group) => (
              <div>
                <h4>{group.category}</h4>
                {group.items.map((item) => {
                  const ServiceIcon = serviceIcons[item.slug];
                  return <a class="mega-service-link" href={`/services/${item.slug}/`}><ServiceIcon class="mega-service-icon" aria-hidden="true" /><span>{item.shortTitle}</span></a>;
                })}
              </div>
            ))}
          </div>
        </div>
        <a href="/projects/" class="nav-link">Projects</a>
        <a href="/pricing/" class="nav-link">Pricing</a>
        <div class="nav-group resources-wrap">
          <button class="nav-link" aria-haspopup="true" aria-expanded="false">Resources</button>
          <div class="mega resources-menu">
            <a href="/blog/">Blogs</a>
            <a href="/templates/">Templates</a>
          </div>
        </div>
        <a href="/contact/" class="nav-cta"><span class="nav-cta-full">Get a Free Quote</span><span class="nav-cta-short">Free Quote</span></a>
        <div class="nav-menu" id="navMenuWrap">
          <button class="lang-btn nav-menu-btn" id="navMenuBtn" aria-label="Menu"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
          <div class="lang-menu nav-drop" id="navDrop">
            {byCategory.map((group) => (
              <>
                <strong>{group.category}</strong>
                {group.items.map((item) => {
                  const ServiceIcon = serviceIcons[item.slug];
                  return <a href={`/services/${item.slug}/`}><ServiceIcon class="mega-service-icon" aria-hidden="true" />{item.shortTitle}</a>;
                })}
              </>
            ))}
            <a href="/projects/">Projects</a>
            <a href="/pricing/">Pricing</a>
            <strong>Resources</strong>
            <a href="/blog/">Blogs</a>
            <a href="/templates/">Templates</a>
          </div>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <span class="brand-mark" aria-hidden="true">S</span>
      <div class="footer-links"><a href="/services/web-design/">Services</a><span>·</span><a href="/projects/">Projects</a><span>·</span><a href="/blog/">Blog</a><span>·</span><a href="/contact/">Contact</a></div>
      <p>© {year} SynoIT. All rights reserved.</p>
      <p class="footer-credit">Singapore HQ · Bangladesh Hub · Global delivery</p>
    </footer>

    <script is:inline src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.3.11/dist/lenis.min.js"></script>
    <script is:inline src="/scripts/home-experience.js"></script>
  </body>
</html>
